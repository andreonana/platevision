# ==============================================================================
# PlateVision — Variables d'environnement
# Copier ce fichier vers .env et adapter les valeurs à votre environnement local
# IMPORTANT : Ne jamais versionner le fichier .env
# ==============================================================================

# --- Chemins des données ---
# Dossier contenant les images brutes non prétraitées
DATA_RAW_PATH=data/raw/

# Dossier contenant les images prétraitées prêtes pour l'entraînement
DATA_PROCESSED_PATH=data/processed/

# Dossier des annotations (format YOLO .txt ou COCO JSON)
DATA_ANNOTATIONS_PATH=data/annotations/

# --- Chemins des modèles ---
# Dossier de sauvegarde des poids entraînés
MODELS_WEIGHTS_PATH=models/weights/

# Chemin vers les embeddings CNN sauvegardés (Module B)
EMBEDDINGS_PATH=models/embeddings.npy

# --- Paramètres de détection YOLO ---
# Seuil de confiance minimum pour la détection d'une plaque (0.0 à 1.0)
YOLO_CONFIDENCE_THRESHOLD=0.5

# Seuil IoU pour la suppression des doublons (Non-Maximum Suppression)
YOLO_IOU_THRESHOLD=0.45

# Taille des images en entrée du modèle YOLO
YOLO_IMAGE_SIZE=640

# --- Paramètres OCR ---
# Langues cibles pour EasyOCR (fr=français, en=anglais)
OCR_LANGUAGES=fr,en

# Seuil de confiance minimum pour les caractères reconnus
OCR_CONFIDENCE_THRESHOLD=0.3

# --- Paramètres Module B (Clustering) ---
# Nombre de clusters K-Means (à ajuster selon analyse du coude)
KMEANS_N_CLUSTERS=8

# Seed de reproductibilité pour les algorithmes stochastiques
RANDOM_SEED=42

# --- Paramètres Module C (MDP) ---
# Facteur d'actualisation gamma (entre 0 et 1)
MDP_GAMMA=0.9

# Seuil de convergence pour Value Iteration et Policy Iteration
MDP_CONVERGENCE_THRESHOLD=0.001

# Nombre maximum d'itérations (protection contre divergence)
MDP_MAX_ITERATIONS=1000

# --- Paramètres d'entraînement ---
# Nombre d'epochs pour l'entraînement YOLO
TRAINING_EPOCHS=100

# Taille de batch pour l'entraînement
TRAINING_BATCH_SIZE=16

# Taux d'apprentissage initial
TRAINING_LEARNING_RATE=0.001

# Utiliser le GPU si disponible (True/False)
USE_GPU=True

# --- Chemins de sortie ---
# Dossier de sauvegarde des rapports et résultats
OUTPUT_REPORTS_PATH=reports/

# Dossier de sauvegarde des figures et visualisations
OUTPUT_FIGURES_PATH=reports/figures/

# --- Logging ---
# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
